<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Work Experience Draft</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f4f6fb;
            margin: 0;
            padding: 2rem;
            color: #0f172a;
        }

        .container {
            max-width: 860px;
            margin: 0 auto;
            background: #fff;
            padding: 2rem 2.5rem;
            border-radius: 1rem;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
        }

        h1 {
            margin-top: 0;
            font-size: 1.9rem;
        }

        .subheading {
            margin-bottom: 2rem;
            color: #475569;
            font-size: 1rem;
        }

        form {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
            margin-bottom: 1.75rem;
        }

        label {
            display: block;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 0.4rem;
        }

        input[type="number"] {
            width: 120px;
            padding: 0.6rem 0.75rem;
            border-radius: 0.6rem;
            border: 1px solid #cbd5f5;
            font-size: 1rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input[type="number"]:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
            outline: none;
        }

        .refresh-btn {
            padding: 0.75rem 1.4rem;
            border: none;
            border-radius: 0.6rem;
            background: #4338ca;
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.1s ease;
        }

        .refresh-btn:hover {
            background: #3730a3;
        }

        .refresh-btn:active {
            transform: translateY(1px);
        }

        .alert {
            padding: 1rem 1.25rem;
            border-radius: 0.6rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .alert-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .generator-card {
            background: #f8fafc;
            padding: 1.75rem;
            border-radius: 1rem;
            border: 1px solid #e2e8f0;
            line-height: 1.65;
        }

        .generator-card h2,
        .generator-card h3,
        .generator-card h4 {
            margin-top: 0;
            color: #1f2937;
        }

        .experience-item {
            margin-bottom: 1.5rem;
        }

        .experience-role {
            font-weight: 600;
            font-size: 1.05rem;
            color: #1f2937;
        }

        .experience-list {
            margin: 0.75rem 0 0;
            padding-left: 1.25rem;
            list-style: disc;
        }

        .experience-list li {
            margin-bottom: 0.6rem;
        }

        .experience-item:last-of-type {
            margin-bottom: 0;
        }

        .generator-card p {
            margin: 0.5rem 0;
        }

        .empty-state {
            padding: 2rem;
            text-align: center;
            background: #f8fafc;
            border-radius: 1rem;
            border: 1px dashed #cbd5f5;
            color: #64748b;
        }

        @media (max-width: 600px) {
            .container {
                padding: 1.5rem;
            }

            form {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Work Experience Draft</h1>
    <p class="subheading">Generated from your indexed work logs. Adjust the number of entries to expand or tighten the narrative.</p>

    <form method="get" action="{{ path('cv_work_experience_page') }}">
        <div>
            <label for="limit">Entries to include</label>
            <input type="number" name="limit" id="limit" min="1" value="{{ limit }}">
        </div>
        <button class="refresh-btn" type="submit">Regenerate</button>
    </form>

    {% if error %}
        <div class="alert alert-error">{{ error }}</div>
    {% elseif formattedWorkExperience %}
        <div class="generator-card">
            {{ formattedWorkExperience|raw }}
        </div>
    {% else %}
        <div class="empty-state">
            Add a few work log entries first, then regenerate to see your CV-ready work experience section here.
        </div>
    {% endif %}
</div>
</body>
</html>
