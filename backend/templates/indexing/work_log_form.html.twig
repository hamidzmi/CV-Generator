<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Log Work Entry</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f7f9fc;
            margin: 0;
            padding: 2rem;
        }

        .container {
            max-width: 720px;
            margin: 0 auto;
            background: #fff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        h1 {
            margin-top: 0;
            font-size: 1.75rem;
            color: #0f172a;
        }

        .field-group {
            margin-bottom: 1.75rem;
        }

        label {
            display: block;
            margin-bottom: 0.4rem;
            font-weight: 600;
            color: #1e293b;
        }

        input[type="text"],
        input[type="datetime-local"],
        textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #cbd5f5;
            border-radius: 0.6rem;
            font-size: 1rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input:focus,
        textarea:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
            outline: none;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .help {
            color: #64748b;
            font-size: 0.85rem;
            margin-top: 0.25rem;
        }

        .error {
            color: #dc2626;
            font-size: 0.9rem;
            margin-top: 0.35rem;
        }

        .alert {
            padding: 1rem 1.25rem;
            border-radius: 0.6rem;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .alert-success {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .submit-btn {
            background: #4f46e5;
            color: #fff;
            border: none;
            border-radius: 0.6rem;
            padding: 0.85rem 1.4rem;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.1s ease;
        }

        .submit-btn:hover {
            background: #4338ca;
        }

        .submit-btn:active {
            transform: translateY(1px);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.75rem;
        }
    </style>
</head>

<body>

    <div class="container">
        <h1>Log Work Entry</h1>
        <p class="help">Capture daily accomplishments so they can be used for your next CV.</p>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('work_log_new') }}">

            <div class="grid">
                <div class="field-group">
                    <label for="projectName">Project / Client</label>
                    <input type="text" id="projectName" name="projectName" value="{{ data.projectName }}">
                </div>

                <div class="field-group">
                    <label for="role">Role</label>
                    <input type="text" id="role" name="role" value="{{ data.role }}" placeholder="Backend Engineer">
                </div>
            </div>

            <div class="grid">
                <div class="field-group">
                    <label for="workType">Work Type</label>
                    <input type="text" id="workType" name="workType" value="{{ data.workType }}" placeholder="Feature, Bug, Research">
                </div>

                <div class="field-group">
                    <label for="technologies">Technologies</label>
                    <input type="text" id="technologies" name="technologies" value="{{ data.technologies }}" placeholder="Comma separated e.g. Symfony, PHP">
                </div>
            </div>

            <div class="field-group">
                <label for="text">What did you achieve today? *</label>
                <textarea id="text" name="text" required>{{ data.text }}</textarea>
                {% if errors.text is defined %}
                    <div class="error">{{ errors.text }}</div>
                {% endif %}
            </div>

            <div class="field-group">
                <label for="businessImpact">Business Impact</label>
                <textarea id="businessImpact" name="businessImpact" placeholder="Describe the outcome or value delivered">{{ data.businessImpact }}</textarea>
            </div>

            <div class="field-group">
                <label for="collaborators">Collaborators</label>
                <input type="text" id="collaborators" name="collaborators" value="{{ data.collaborators }}" placeholder="Comma separated names">
            </div>

            {% if errors.embedding is defined %}
                <div class="error">{{ errors.embedding }}</div>
            {% endif %}

            <button class="submit-btn" type="submit">Submit</button>
        </form>
    </div>
</body>
</html>
